#!/bin/sh
# CameVision USB 3.2 Gen 1 (SuperSpeed 5 Gbps) UVC-only gadget.
# First UDC bind — do not create ADB. Switching gadgets after ADB wedges dwc3.
#
# Silicon is RV1126B USB 3.0 DRD = USB 3.2 Gen 1. Not 10 Gbps.

. /etc/profile

G=/sys/kernel/config/usb_gadget/camevision
U=$G/functions/uvc.0
C=$G/configs/b.1

usb_stop()
{
	echo none > $G/UDC 2>/dev/null
	start-stop-daemon -K -x /oem/usr/bin/camevision-uvc.sh 2>/dev/null
	rm -f $C/f1
}

usb_start()
{
	ifconfig lo up
	mount -t configfs none /sys/kernel/config 2>/dev/null

	mkdir -p $G
	echo 0x2207 > $G/idVendor
	echo 0x0005 > $G/idProduct
	echo 0x0320 > $G/bcdUSB
	echo 0x0100 > $G/bcdDevice
	echo 0xEF > $G/bDeviceClass
	echo 0x02 > $G/bDeviceSubClass
	echo 0x01 > $G/bDeviceProtocol

	mkdir -p $G/strings/0x409
	SERIAL=`awk '/Serial/{print $3}' /proc/cpuinfo`
	[ -z "$SERIAL" -o "$SERIAL" = "0" ] && SERIAL=camevision
	echo $SERIAL > $G/strings/0x409/serialnumber
	echo CameMake > $G/strings/0x409/manufacturer
	echo "CameVision Single" > $G/strings/0x409/product

	mkdir -p $C/strings/0x409
	echo uvc > $C/strings/0x409/configuration
	echo 896 > $C/MaxPower
	echo 0x80 > $C/bmAttributes

	mkdir -p $U
	echo CameVision > $U/function_name
	echo 1024 > $U/streaming_maxpacket
	echo 2 > $U/streaming_maxburst
	echo 1 > $U/streaming_interval
	[ -e $U/streaming_bulk ] && echo 0 > $U/streaming_bulk
	[ -e $U/control/enable_interrupt_ep ] && echo 0 > $U/control/enable_interrupt_ep

	mkdir -p $U/control/header/h
	ln -sf $U/control/header/h $U/control/class/fs/h
	ln -sf $U/control/header/h $U/control/class/ss/h
	[ -d $U/control/class/hs ] && ln -sf $U/control/header/h $U/control/class/hs/h

	mkdir -p $U/streaming/mjpeg/m/1080p
	echo 1920 > $U/streaming/mjpeg/m/1080p/wWidth
	echo 1080 > $U/streaming/mjpeg/m/1080p/wHeight
	echo 333333 > $U/streaming/mjpeg/m/1080p/dwDefaultFrameInterval
	echo 124416000 > $U/streaming/mjpeg/m/1080p/dwMinBitRate
	echo 124416000 > $U/streaming/mjpeg/m/1080p/dwMaxBitRate
	echo 4147200 > $U/streaming/mjpeg/m/1080p/dwMaxVideoFrameBufferSize
	printf '333333\n' > $U/streaming/mjpeg/m/1080p/dwFrameInterval

	mkdir -p $U/streaming/header/h
	ln -sf $U/streaming/mjpeg/m $U/streaming/header/h/m
	ln -sf $U/streaming/header/h $U/streaming/class/fs/h
	ln -sf $U/streaming/header/h $U/streaming/class/hs/h
	ln -sf $U/streaming/header/h $U/streaming/class/ss/h

	ln -sf $U $C/f1

	i=0
	UDC=
	while [ $i -lt 25 ]; do
		UDC=`ls /sys/class/udc 2>/dev/null | awk '{print $1}'`
		[ -n "$UDC" ] && break
		sleep 1
		i=$((i+1))
	done
	[ -n "$UDC" ] || exit 1

	i=0
	while [ $i -lt 40 ]; do
		if printf '%s' "$UDC" > $G/UDC 2>/dev/null; then
			cat $G/UDC | grep -q . && break
		fi
		sleep 1
		i=$((i+1))
	done

	if [ -x /oem/usr/bin/camevision-uvc.sh ]; then
		start-stop-daemon -S -b -x /oem/usr/bin/camevision-uvc.sh
	fi
}

case "$1" in
start)
	usb_start
	;;
stop)
	usb_stop
	;;
restart|reload)
	usb_stop
	sleep 1
	usb_start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac
exit 0
