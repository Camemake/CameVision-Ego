#!/bin/sh
# First USB bind is the M1 gadget ELF (UVC-only). Do not create the
# rockchip ADB gadget — switching to UVC after ADB wedges dwc3.
#
# Usage: installed as /etc/init.d/S50usbdevice
# Fallback: if the ELF is missing, start the ADB-only script beside this file.

case "$1" in
start)
	mkdir -p /run/efr /var/lib/efference /dev/usb-ffs
	mount -t configfs none /sys/kernel/config 2>/dev/null
	echo 0xFF > /sys/devices/platform/ff3e0000.i2c/i2c-3/3-0020/leds/rgb_led/multi_intensity 2>/dev/null

	if [ -x /userdata/camevision-gadget.elf ]; then
		start-stop-daemon -S -b -x /userdata/camevision-gadget.elf -- --usb --no-adb
	elif [ -x /oem/usr/bin/camevision-gadget.elf ]; then
		start-stop-daemon -S -b -x /oem/usr/bin/camevision-gadget.elf -- --usb --no-adb
	elif [ -x /etc/init.d/S50usbdevice.adb ]; then
		exec /etc/init.d/S50usbdevice.adb start
	fi

	if [ -x /oem/usr/bin/camevision-uvc.sh ]; then
		start-stop-daemon -S -b -x /oem/usr/bin/camevision-uvc.sh
	fi
	;;
stop)
	start-stop-daemon -K -x /userdata/camevision-gadget.elf 2>/dev/null
	start-stop-daemon -K -x /oem/usr/bin/camevision-gadget.elf 2>/dev/null
	start-stop-daemon -K -x /oem/usr/bin/camevision-uvc.sh 2>/dev/null
	echo none > /sys/kernel/config/usb_gadget/efference/UDC 2>/dev/null
	;;
restart)
	$0 stop
	sleep 1
	$0 start
	;;
esac
exit 0
