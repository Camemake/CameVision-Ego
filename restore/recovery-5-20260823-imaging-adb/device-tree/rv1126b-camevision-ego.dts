// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * CameVision Ego — RV1126B, schematic CameVisionEgo V1.I1 (2026-07-15)
 *
 * Pin map is net name → BGA pad → GPIO, from schematic-ego/schematic_text.txt,
 * checked against the RV1126B pinctrl groups in the SoC dtsi.
 *
 * Same as Single (do not "correct" these from the PDF RAM/IMU labels):
 *   DDR4 U3     K4A8G165WG 16-bit 1 GB (PDF says K4A4G165WG — wrong)
 *   IMU U9/U12  LSM6DSVQTR x2     (PDF says LSM6DSV320XTR — wrong)
 *   eMMC U2A    BWCTAK611G16G     (same MPN on Single)
 *
 * Ego-only vs Single:
 *   two SC233HGS (CSI0+I2C3, CSI1+I2C4), two SPI IMUs, microSD on SDMMC0,
 *   Wi-Fi GPIOs moved off GPIO2 (that bank is the SD card), BQ24072 CHG,
 *   camera LDO enables on GPIO0_B0/B1/B2.
 *
 * Do not use stock sdmmc0_detn_pins (GPIO0_A5) — that pad is the green LED.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/clock/rockchip,rv1126b-cru.h>
#include "rv1126b.dtsi"

/ {
	model = "CameVision Ego";
	compatible = "camemake,camevision-ego", "rockchip,rv1126b";

	chosen {
		stdout-path = "serial0:1500000n8";
	};

	fiq_debugger: fiq-debugger {
		compatible = "rockchip,fiq-debugger";
		rockchip,serial-id = <0>;
		rockchip,wake-irq = <0>;
		rockchip,irq-mode-enable = <1>;
		rockchip,baudrate = <1500000>;
		interrupts = <GIC_SPI 233 IRQ_TYPE_LEVEL_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&uart0m2_xfer_pins>;
		status = "okay";
	};

	vcc5v_dcin: vcc5v-dcin {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v_dcin";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	vcc5v0_sys: vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v_dcin>;
	};

	vdd_cpu: vdd-cpu {
		compatible = "regulator-fixed";
		regulator-name = "vdd_cpu";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <950000>;
		regulator-max-microvolt = <950000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc2v5_ddr_vpp: vcc2v5-ddr-vpp {
		compatible = "regulator-fixed";
		regulator-name = "vcc2v5_ddr_vpp";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <2500000>;
		regulator-max-microvolt = <2500000>;
		vin-supply = <&vcc3v3_sys>;
	};

	/* U15 LDLN025PU28R. "PWR_EN_2.8V" GPIO0_B0, pad 1AB4. */
	vcc2v8_cam: vcc2v8-cam {
		compatible = "regulator-fixed";
		regulator-name = "vcc2v8_cam";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-boot-on;
		regulator-always-on;
		gpio = <&gpio0 RK_PB0 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <1000>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_avdd_en>;
		vin-supply = <&vcc3v3_sys>;
	};

	/* U16 MIC5317-1.5. "PWR_EN_1.5V" GPIO0_B1, pad 1AA4. */
	vcc1v5_cam: vcc1v5-cam {
		compatible = "regulator-fixed";
		regulator-name = "vcc1v5_cam";
		regulator-min-microvolt = <1500000>;
		regulator-max-microvolt = <1500000>;
		regulator-boot-on;
		regulator-always-on;
		gpio = <&gpio0 RK_PB1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <1000>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_1v5_en>;
		vin-supply = <&vcc3v3_sys>;
	};

	/* U18 SGM2036-1.2. "PWR_EN_1.2V" GPIO0_B2, pad 1AC2. SC233 DVDD. */
	vcc1v2_cam: vcc1v2-cam {
		compatible = "regulator-fixed";
		regulator-name = "vcc1v2_cam";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		regulator-boot-on;
		regulator-always-on;
		gpio = <&gpio0 RK_PB2 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <1000>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_dvdd_en>;
		vin-supply = <&vcc3v3_sys>;
	};

	vcc1v8_cam: vcc1v8-cam {
		compatible = "regulator-fixed";
		regulator-name = "vcc1v8_cam";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc_1v8>;
	};

	/*
	 * microSD U6 is switched 1.8 V ("+1.8V_SDC_PWR").
	 * "SDMMC0_PWREN" GPIO3_B4, pad 1A14. Do not use dtsi sdmmc0_pwren
	 * (that group is GPIO0_A10).
	 */
	vcc1v8_sd: vcc1v8-sd {
		compatible = "regulator-fixed";
		regulator-name = "vcc1v8_sd";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&gpio3 RK_PB4 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <20000>;
		pinctrl-names = "default";
		pinctrl-0 = <&sd_pwren>;
		vin-supply = <&vcc_1v8>;
	};

	/*
	 * Module 3.3 V is switched by WIFI_RST / WIFI_POW_EN (GPIO3_B2) in
	 * sdio-pwrseq. WIFI_SOC_PWCTL GPIO3_B6 is HOST_WAKE, not the rail.
	 * Live FIT uses vcc_3v3 as vmmc; keep this always-on so a compiled
	 * tree does not steal GPIO3_B2 from pwrseq.
	 */
	vcc3v3_wifi: vcc3v3-wifi {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_wifi";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc3v3_sys>;
	};

	/*
	 * D1 common-anode RGB, active low. Same pads as Single:
	 *   STATUS_LED_R  GPIO0_A6  pad 1AA6
	 *   STATUS_LED_G  GPIO0_A5  pad AL10
	 *   STATUS_LED_B  GPIO0_A4  pad 1AB6
	 */
	leds: gpio-leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&status_led_pins>;

		status_led_r: led-0 {
			label = "status:red";
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio0 RK_PA6 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		status_led_g: led-1 {
			label = "status:green";
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		status_led_b: led-2 {
			label = "status:blue";
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio0 RK_PA4 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_reg_on>;
		post-power-on-delay-ms = <200>;
		/*
		 * "WIFI_RST" GPIO3_B2, pad 1B16. On Ego this net is also
		 * CHIP_EN and WIFI_POW_EN (3.3 V switch). Active-low so
		 * deassert keeps the module powered. Do not copy Single's
		 * active-high RST — that leaves CHIP_EN low after pwrseq.
		 */
		reset-gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>;
	};

	wireless_wlan: wireless-wlan {
		compatible = "wlan-platdata";
		wifi_chip_type = "vs6621";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_wake_host>;
		/* "WIFI_INT" GPIO3_B7, pad A16. On Single this was GPIO2_A5. */
		WIFI,host_wake_irq = <&gpio3 RK_PB7 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	wireless_bluetooth: wireless-bluetooth {
		compatible = "bluetooth-platdata";
		uart_rts_gpios = <&gpio3 RK_PA6 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default", "rts_gpio";
		pinctrl-0 = <&uart2m0_rtsn_pins>;
		pinctrl-1 = <&uart2_gpios>;
		status = "okay";
	};

	/* U13 BQ24072RGTR. CHG → "BAT_CHG" GPIO0_A7, pad 1AC4, active low. */
	charger: gpio-charger {
		compatible = "gpio-charger";
		charger-type = "usb";
		charge-status-gpios = <&gpio0 RK_PA7 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&bat_chg_pins>;
		status = "okay";
	};
};

/* ---------------------------------------------------------------- power --- */

&i2c0 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0m0_pins>;

	rk801: pmic@27 {
		compatible = "rockchip,rk801";
		reg = <0x27>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PC0 IRQ_TYPE_LEVEL_LOW>;
		pwrctrl-gpios = <&gpio0 RK_PC1 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default", "pmic-reset";
		pinctrl-0 = <&pmic_int_pins>;
		pinctrl-1 = <&pmic_pwrctrl_pins>;
		rockchip,system-power-controller;
		wakeup-source;
		status = "okay";

		vcc1-supply = <&vcc5v_dcin>;
		vcc2-supply = <&vcc5v_dcin>;
		vcc3-supply = <&vcc5v0_sys>;
		vcc4-supply = <&vcc5v0_sys>;
		vcc5-supply = <&vcc3v3_sys>;
		vcc6-supply = <&vcc3v3_sys>;
		vcc7-supply = <&vcc3v3_sys>;

		regulators {
			vdd_npu: DCDC_REG1 {
				regulator-name = "vdd_npu";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1500000>;
				regulator-initial-mode = <0x1>;
				regulator-boot-on;
				regulator-always-on;

				regulator-state-mem {
					regulator-mode = <0x2>;
					regulator-off-in-suspend;
				};
			};

			vcc3v3_sys: DCDC_REG2 {
				regulator-name = "vcc3v3_sys";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-initial-mode = <0x1>;
				regulator-boot-on;
				regulator-always-on;

				regulator-state-mem {
					regulator-mode = <0x2>;
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcc_ddr: DCDC_REG3 {
				regulator-name = "vcc_ddr";
				regulator-initial-mode = <0x1>;
				regulator-boot-on;
				regulator-always-on;

				regulator-state-mem {
					regulator-mode = <0x2>;
					regulator-on-in-suspend;
				};
			};

			vdd_logic: DCDC_REG4 {
				regulator-name = "vdd_logic";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1500000>;
				regulator-initial-mode = <0x1>;
				regulator-boot-on;
				regulator-always-on;

				regulator-state-mem {
					regulator-mode = <0x2>;
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <900000>;
				};
			};

			vdd0v9_sys: LDO_REG1 {
				regulator-name = "vdd0v9_sys";
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;
				regulator-boot-on;
				regulator-always-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <900000>;
				};
			};

			vcc_1v8: LDO_REG2 {
				regulator-name = "vcc_1v8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			vcc_3v3: SWITCH_REG {
				regulator-name = "vcc_3v3";
				regulator-boot-on;
				regulator-always-on;

				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};
		};
	};
};

&cpu0 {
	cpu-supply = <&vdd_cpu>;
};

&dmc {
	center-supply = <&vdd_logic>;
	status = "okay";
};

&saradc0 {
	status = "okay";
	vref-supply = <&vcc_1v8>;
};

/* ----------------------------------------------------------- rtc / imu --- */

&i2c2 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2m0_pins>;

	rtc_rv3028: rtc@52 {
		compatible = "microcrystal,rv3028";
		reg = <0x52>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PC5 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&rtc_int_pins>;
		wakeup-source;
		status = "okay";
	};
};

/* IMU0 U9 next to Cam 0. SPI0_M2 on GPIO5_A3/A4/A5/A6. */
&spi0 {
	status = "okay";
	max-freq = <10000000>;
	pinctrl-names = "default";
	pinctrl-0 = <&spi0m2_clk_pins &spi0m2_csn0_pins>;

	imu0: imu@0 {
		compatible = "st,lsm6dsv";
		reg = <0>;
		spi-max-frequency = <1000000>;
		spi-cpha;
		spi-cpol;
		interrupt-parent = <&gpio5>;
		interrupts = <RK_PB1 IRQ_TYPE_EDGE_RISING>;	/* IMU0_INT1, 1K23 */
		st,drdy-int-pin = <1>;
		st,disable-sensor-hub;
		st,odr-triggered;
		pinctrl-names = "default";
		pinctrl-0 = <&imu0_int_pins>;
		vdd-supply = <&vcc_1v8>;
		vddio-supply = <&vcc_1v8>;
		mount-matrix = "1", "0", "0",
			       "0", "1", "0",
			       "0", "0", "1";
		status = "okay";
	};
};

/* IMU1 U12 next to Cam 1. Same SPI1_M0 pads as the Single IMU. */
&spi1 {
	status = "okay";
	max-freq = <10000000>;
	pinctrl-names = "default";
	pinctrl-0 = <&spi1m0_clk_pins &spi1m0_csn0_pins>;

	imu1: imu@0 {
		compatible = "st,lsm6dsv";
		reg = <0>;
		spi-max-frequency = <1000000>;
		spi-cpha;
		spi-cpol;
		interrupt-parent = <&gpio6>;
		interrupts = <RK_PB5 IRQ_TYPE_EDGE_RISING>;	/* IMU1_INT1, 1M22 */
		st,drdy-int-pin = <1>;
		st,disable-sensor-hub;
		st,odr-triggered;
		pinctrl-names = "default";
		pinctrl-0 = <&imu1_int_pins>;
		vdd-supply = <&vcc_1v8>;
		vddio-supply = <&vcc_1v8>;
		mount-matrix = "1", "0", "0",
			       "0", "1", "0",
			       "0", "0", "1";
		status = "okay";
	};
};

/* -------------------------------------------------------------- camera --- */

&i2c3 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3m1_pins>;	/* GPIO4_A4/A5, I2C3_SCL/SDA_CAM */

	sc233hgs_0: sc233hgs@30 {
		compatible = "smartsens,sc233hgs";
		reg = <0x30>;
		clocks = <&cru CLK_CAM0_OUT>;
		clock-names = "xvclk";
		assigned-clocks = <&cru CLK_CAM0_OUT>;
		assigned-clock-rates = <27000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk0_pins &cam0_pwdn_pins>;
		/* "CAM0_PWDN" GPIO4_A3, pad 1V21. Single used GPIO4_A6. */
		pwdn-gpios = <&gpio4 RK_PA3 GPIO_ACTIVE_HIGH>;
		avdd-supply = <&vcc2v8_cam>;
		dovdd-supply = <&vcc1v8_cam>;
		dvdd-supply = <&vcc1v2_cam>;
		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "efference-sc233hgs";
		rockchip,camera-module-lens-name = "default";
		status = "okay";

		port {
			sc233hgs0_out: endpoint {
				remote-endpoint = <&csi_dphy0_input>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
};

/*
 * Cam 1 I2C is swapped on the PCB vs I2C4_M2 (schematic page 9 netlist):
 *   I2C4_SCL_CAM → U1.1T21 GPIO4_A6 (SoC function I2C4_SDA_M2) → U10.A3 SCL
 *   I2C4_SDA_CAM → U1.1T22 GPIO4_A7 (SoC function I2C4_SCL_M2) → U10.B3 SDA
 * Hardware I2C4 cannot swap those functions. Bit-bang the net names.
 * Live: ACK at 0x30 with SCL=A6 SDA=A7 and CAM1_PWDN raw high.
 */
&i2c4 {
	status = "disabled";
};

i2c_cam1: i2c-gpio-cam1 {
	compatible = "i2c-gpio";
	sda-gpios = <&gpio4 RK_PA7 GPIO_ACTIVE_HIGH>;
	scl-gpios = <&gpio4 RK_PA6 GPIO_ACTIVE_HIGH>;
	i2c-gpio,delay-us = <2>;
	#address-cells = <1>;
	#size-cells = <0>;

	sc233hgs_1: sc233hgs@30 {
		compatible = "smartsens,sc233hgs";
		reg = <0x30>;
		clocks = <&cru CLK_CAM1_OUT>;
		clock-names = "xvclk";
		assigned-clocks = <&cru CLK_CAM1_OUT>;
		assigned-clock-rates = <27000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk1_pins &cam1_pwdn_pins>;
		/* "CAM1_PWDN" GPIO4_A2, pad 1Y23. XSHUTDN high = run. */
		reset-gpios = <&gpio4 RK_PA2 GPIO_ACTIVE_LOW>;
		avdd-supply = <&vcc2v8_cam>;
		dovdd-supply = <&vcc1v8_cam>;
		dvdd-supply = <&vcc1v2_cam>;
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "front";
		rockchip,camera-module-name = "efference-sc233hgs";
		rockchip,camera-module-lens-name = "default";
		status = "okay";

		port {
			sc233hgs1_out: endpoint {
				remote-endpoint = <&csi_dphy1_input>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
};

&csi2_dphy0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			csi_dphy0_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&sc233hgs0_out>;
				data-lanes = <1 2 3 4>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			csidphy0_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&mipi0_csi2_input>;
			};
		};
	};
};

&csi2_dphy1 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			csi_dphy1_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&sc233hgs1_out>;
				data-lanes = <1 2 3 4>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			csidphy1_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&mipi1_csi2_input>;
			};
		};
	};
};

/*
 * Cam 0: sc233hgs_0 -> csi2_dphy0 -> mipi0_csi2 -> rkcif_mipi_lvds
 *                      -> rkisp_vir0 -> rkvpss_vir0
 * Cam 1: sc233hgs_1 -> csi2_dphy1 -> mipi1_csi2 -> rkcif_mipi_lvds1
 *                      -> rkisp_vir1 -> rkvpss_vir1
 */
&mipi0_csi2 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi0_csi2_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&csidphy0_out>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi0_csi2_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cif_mipi_in0>;
			};
		};
	};
};

&mipi1_csi2 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi1_csi2_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&csidphy1_out>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi1_csi2_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cif_mipi_in1>;
			};
		};
	};
};

&rkcif {
	status = "okay";
};

&rkcif_mipi_lvds {
	status = "okay";

	port {
		cif_mipi_in0: endpoint {
			remote-endpoint = <&mipi0_csi2_output>;
		};
	};
};

&rkcif_mipi_lvds1 {
	status = "okay";

	port {
		cif_mipi_in1: endpoint {
			remote-endpoint = <&mipi1_csi2_output>;
		};
	};
};

&rkcif_mipi_lvds_sditf {
	status = "okay";

	port {
		mipi_lvds_sditf: endpoint {
			remote-endpoint = <&isp_vir0>;
		};
	};
};

&rkcif_mipi_lvds1_sditf {
	status = "okay";

	port {
		mipi_lvds1_sditf: endpoint {
			remote-endpoint = <&isp_vir1>;
		};
	};
};

&rkisp {
	status = "okay";
};

&rkisp_vir0 {
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		isp_vir0: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&mipi_lvds_sditf>;
		};
	};
};

&rkisp_vir1 {
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		isp_vir1: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&mipi_lvds1_sditf>;
		};
	};
};

&rkisp_vir0_sditf {
	status = "okay";

	port {
		isp_sditf0: endpoint {
			remote-endpoint = <&vpss0_in>;
		};
	};
};

&rkisp_vir1_sditf {
	status = "okay";

	port {
		isp_sditf1: endpoint {
			remote-endpoint = <&vpss1_in>;
		};
	};
};

&rkvpss {
	status = "okay";
};

&rkvpss_vir0 {
	status = "okay";

	port {
		vpss0_in: endpoint {
			remote-endpoint = <&isp_sditf0>;
		};
	};
};

&rkvpss_vir1 {
	status = "okay";

	port {
		vpss1_in: endpoint {
			remote-endpoint = <&isp_sditf1>;
		};
	};
};

&rkdvbm {
	status = "okay";
};

&dsi {
	status = "disabled";
};

/* ------------------------------------------------------ storage / wifi --- */

/* U2A BWCTAK611G16G, 8-bit eMMC, same part as Single. */
&emmc {
	status = "okay";
	bus-width = <8>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	non-removable;
	no-sd;
	no-sdio;
	rockchip,default-sample-phase = <90>;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_pins>;
	vmmc-supply = <&vcc3v3_sys>;
	vqmmc-supply = <&vcc_1v8>;
};

/*
 * microSD on SDMMC0 (GPIO2_A0..A5). Card detect is GPIO3_B3 (1B14), not
 * the dtsi sdmmc0_detn group (GPIO0_A5 = green LED).
 */
&sdmmc0 {
	status = "okay";
	bus-width = <4>;
	cap-sd-highspeed;
	disable-wp;
	no-sdio;
	no-mmc;
	cd-gpios = <&gpio3 RK_PB3 GPIO_ACTIVE_LOW>;
	vmmc-supply = <&vcc1v8_sd>;
	vqmmc-supply = <&vcc_1v8>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_clk_pins &sdmmc0_cmd_pins &sdmmc0_bus4_pins &sd_cd_pins>;
};

&sdmmc1 {
	status = "okay";
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	supports-highspeed;
	sd-uhs-sdr104;
	keep-power-in-suspend;
	non-removable;
	disable-wp;
	no-sd;
	no-mmc;
	max-frequency = <150000000>;
	mmc-pwrseq = <&sdio_pwrseq>;
	vmmc-supply = <&vcc3v3_wifi>;
	vqmmc-supply = <&vcc_1v8>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc1_clk_pins &sdmmc1_cmd_pins &sdmmc1_bus4_pins>;
};

/* ---------------------------------------------------------------- uart --- */

&uart0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart0m2_xfer_pins>;
};

&uart2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart2m0_xfer_pins &uart2m0_ctsn_pins &uart2m0_rtsn_pins>;
};

/* ----------------------------------------------------------------- usb --- */

&usb2phy {
	status = "okay";
};

&usb2phy_otg {
	status = "okay";
};

&usb3phy {
	status = "okay";
};

&usb_drd_dwc3 {
	status = "okay";
	dr_mode = "peripheral";
};

&usb_host_ehci {
	status = "disabled";
};

&usb_host_ohci {
	status = "disabled";
};

/* ------------------------------------------------------------- unused --- */

&gmac {
	status = "disabled";
};

&i2c1 {
	status = "disabled";
};

&i2c5 {
	status = "disabled";
};

/* -------------------------------------------------------------- pinmux --- */

&pinctrl {
	pmic {
		pmic_int_pins: pmic-int-pins {
			rockchip,pins = <0 RK_PC0 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		pmic_pwrctrl_pins: pmic-pwrctrl-pins {
			rockchip,pins = <0 RK_PC1 RK_FUNC_GPIO &pcfg_output_high>;
		};
	};

	status-led {
		status_led_pins: status-led-pins {
			rockchip,pins =
				<0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>,
				<0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>,
				<0 RK_PA4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	camera {
		cam0_pwdn_pins: cam0-pwdn-pins {
			rockchip,pins = <4 RK_PA3 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		cam1_pwdn_pins: cam1-pwdn-pins {
			rockchip,pins = <4 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		cam_avdd_en: cam-avdd-en {
			rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_output_high>;
		};

		cam_1v5_en: cam-1v5-en {
			rockchip,pins = <0 RK_PB1 RK_FUNC_GPIO &pcfg_output_high>;
		};

		cam_dvdd_en: cam-dvdd-en {
			rockchip,pins = <0 RK_PB2 RK_FUNC_GPIO &pcfg_output_high>;
		};
	};

	rtc {
		rtc_int_pins: rtc-int-pins {
			rockchip,pins = <0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		rtc_evi_pins: rtc-evi-pins {
			rockchip,pins = <0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	imu {
		imu0_int_pins: imu0-int-pins {
			rockchip,pins =
				<5 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>,
				<5 RK_PD4 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		imu1_int_pins: imu1-int-pins {
			rockchip,pins =
				<6 RK_PB5 RK_FUNC_GPIO &pcfg_pull_none>,
				<6 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	sd-card {
		sd_cd_pins: sd-cd-pins {
			rockchip,pins = <3 RK_PB3 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		sd_pwren: sd-pwren {
			rockchip,pins = <3 RK_PB4 RK_FUNC_GPIO &pcfg_output_high>;
		};
	};

	wifi {
		wifi_reg_on: wifi-reg-on {
			rockchip,pins = <3 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		wifi_pwctl_en: wifi-pwctl-en {
			rockchip,pins = <3 RK_PB6 RK_FUNC_GPIO &pcfg_output_low>;
		};

		wifi_wake_host: wifi-wake-host {
			rockchip,pins = <3 RK_PB7 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	bluetooth {
		uart2_gpios: uart2-gpios {
			rockchip,pins = <3 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	battery {
		bat_chg_pins: bat-chg-pins {
			rockchip,pins = <0 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};
