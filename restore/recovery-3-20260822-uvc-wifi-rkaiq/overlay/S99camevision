#!/bin/sh
# Boot helpers. Never change the USB gadget. Never insmod rockit.
# Wi-Fi always joins /userdata/wpa_camevision.conf (Camemake R&D center).
chmod 755 /userdata/camevision-wifi.sh /userdata/camevision-imu.sh /userdata/camevision-stream.sh /userdata/camevision-led.sh /userdata/camevision-aiq.sh /userdata/camevision-uvc-cam.sh /userdata/camevision-uvc-mjpg.py 2>/dev/null
# RGB D1: green=OK, red/blue off. DT leaves red on panic trigger (looks like a fault LED).
if [ -x /userdata/camevision-led.sh ]; then
  /userdata/camevision-led.sh
else
  echo none > /sys/class/leds/status:red/trigger 2>/dev/null
  echo 0 > /sys/class/leds/status:red/brightness 2>/dev/null
  echo none > /sys/class/leds/status:green/trigger 2>/dev/null
  echo 1 > /sys/class/leds/status:green/brightness 2>/dev/null
  echo none > /sys/class/leds/status:blue/trigger 2>/dev/null
  echo 0 > /sys/class/leds/status:blue/brightness 2>/dev/null
fi
( sleep 8
  if [ -x /userdata/camevision-imu.sh ]; then
    /userdata/camevision-imu.sh >/userdata/imu-boot.log 2>&1
  fi
) &
( sleep 6
  i=0
  while [ $i -lt 4 ]; do
    /userdata/camevision-wifi.sh >/userdata/wifi-boot.log 2>&1
    if ip -4 addr show wlan0 2>/dev/null | grep -q 'inet '; then
      break
    fi
    i=$((i + 1))
    sleep 8
  done
) &
( sleep 10
  if [ -x /userdata/camevision-aiq.sh ]; then
    /userdata/camevision-aiq.sh >/userdata/aiq-boot.log 2>&1
  fi
) &
( sleep 14
  if [ -e /userdata/uvc-webcam.on ] && [ -x /userdata/camevision-uvc-cam.sh ]; then
    /userdata/camevision-uvc-cam.sh >/userdata/boot-stream.log 2>&1
  elif [ -e /dev/video13 ]; then
    /userdata/camevision-stream.sh >/userdata/boot-stream.log 2>&1
  fi
) &
exit 0
