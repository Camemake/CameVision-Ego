#!/bin/sh
# Delay so S50 ADB binds first. No gadget changes. Never insmod rockit.
# IMU dump, Wi-Fi STA (+ BLE), then camera RTSP stream.
( sleep 8
  if [ -x /userdata/camevision-imu.sh ]; then
    /userdata/camevision-imu.sh >/userdata/imu-boot.log 2>&1
  fi
) &
( sleep 10
  if [ -x /userdata/camevision-wifi.sh ]; then
    /userdata/camevision-wifi.sh >/userdata/wifi-boot.log 2>&1
  fi
) &
( sleep 12
  if [ -e /dev/video13 ]; then
    /userdata/camevision-stream.sh >/userdata/boot-stream.log 2>&1
  fi
) &
exit 0
