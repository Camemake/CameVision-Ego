// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * CameVision Single - RV1126B carrier + power board
 *
 * Pin assignments below were extracted from the V2.1 MONO-MCU-DDR4 schematic
 * netlist (net name -> BGA pad -> SoC signal) and cross-checked against the
 * RV1126B pinctrl groups in the SoC dtsi. Schematic net names are quoted in
 * comments so this file can be diffed against a future board revision.
 *
 * Board rails (power board):
 *   +5V_MAIN     5.00 V  input
 *   +3V3_SYS     3.30 V  RK801-2 DCDC2
 *   +1V8_MAIN    1.80 V  RK801-2 LDO2
 *   +0V95_CPU    0.95 V  discrete buck (not PMIC controlled)
 *   +0V9_LOGIC   0.90 V  RK801-2 DCDC4, DVFS controlled
 *   +0V95_NPU    0.95 V  RK801-2 DCDC1, DVFS controlled
 *   +1V21_DDR    1.21 V  RK801-2 DCDC3 (DDR4)
 *   +2V5_VPP_DDR 2.50 V  ME6211C25, DDR4 VPP
 *   +0V605_VREF  0.605 V resistor divider from +1V21_DDR, no software control
 *   CAM AVDD     2.80 V  LDLN025PU28R
 *   CAM DVDD     1.50 V  MIC5317-1.5
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/clock/rockchip,rv1126b-cru.h>
#include "rv1126b.dtsi"

/ {
	model = "CameVision Single";
	compatible = "camemake,camevision-single", "rockchip,rv1126b";

	/* 1 GB DDR4 (K4A8G165WG). The DDR init loader publishes the real size,
	 * U-Boot fixes up /memory before handing over, so no memory node here.
	 */

	chosen {
		stdout-path = "serial0:1500000n8";
	};

	/*
	 * Debug console on the PMU UART. GPIO0_B3/GPIO0_B4 are shared with JTAG,
	 * so mux M2 must be selected explicitly.
	 */
	fiq_debugger: fiq-debugger {
		compatible = "rockchip,fiq-debugger";
		rockchip,serial-id = <0>;
		rockchip,wake-irq = <0>;
		rockchip,irq-mode-enable = <1>;
		rockchip,baudrate = <1500000>;
		interrupts = <GIC_SPI 233 IRQ_TYPE_LEVEL_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&uart0m2_xfer_pins>;
		status = "okay";
	};

	vcc5v_dcin: vcc5v-dcin {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v_dcin";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	vcc5v0_sys: vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v_dcin>;
	};

	/* Discrete CPU buck on the power board, no runtime voltage control. */
	vdd_cpu: vdd-cpu {
		compatible = "regulator-fixed";
		regulator-name = "vdd_cpu";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <950000>;
		regulator-max-microvolt = <950000>;
		vin-supply = <&vcc5v0_sys>;
	};

	/* DDR4 VPP. Present for documentation: no enable pin is routed. */
	vcc2v5_ddr_vpp: vcc2v5-ddr-vpp {
		compatible = "regulator-fixed";
		regulator-name = "vcc2v5_ddr_vpp";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <2500000>;
		regulator-max-microvolt = <2500000>;
		vin-supply = <&vcc3v3_sys>;
	};

	/* Camera FPC (J2) rails. */
	vcc2v8_cam: vcc2v8-cam {
		compatible = "regulator-fixed";
		regulator-name = "vcc2v8_cam";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		vin-supply = <&vcc3v3_sys>;
	};

	vcc1v5_cam: vcc1v5-cam {
		compatible = "regulator-fixed";
		regulator-name = "vcc1v5_cam";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1500000>;
		regulator-max-microvolt = <1500000>;
		vin-supply = <&vcc3v3_sys>;
	};

	vcc1v8_cam: vcc1v8-cam {
		compatible = "regulator-fixed";
		regulator-name = "vcc1v8_cam";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc_1v8>;
	};

	/* Wi-Fi/BT module supply gated by "WIFI_SOC_PWCTL" (GPIO2_A4). */
	vcc3v3_wifi: vcc3v3-wifi {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_wifi";
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio2 RK_PA4 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <20000>;
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_pwctl_en>;
		vin-supply = <&vcc3v3_sys>;
	};

	/*
	 * D1 is a common-anode RGB LED, so every channel is active low.
	 *   STATUS_LED_R  GPIO0_A6  pad 1AA6
	 *   STATUS_LED_G  GPIO0_A5  pad AL10
	 *   STATUS_LED_B  GPIO0_A4  pad 1AB6
	 */
	leds: gpio-leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&status_led_pins>;

		status_led_r: led-0 {
			label = "status:red";
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio0 RK_PA6 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		status_led_g: led-1 {
			label = "status:green";
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		status_led_b: led-2 {
			label = "status:blue";
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio0 RK_PA4 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_reg_on>;
		post-power-on-delay-ms = <200>;
		/* "WIFI_RST" GPIO3_B2, pad 1B16 */
		reset-gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>;
	};

	wireless_wlan: wireless-wlan {
		compatible = "wlan-platdata";
		wifi_chip_type = "vs6621";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_wake_host>;
		/* "WIFI_INT" GPIO2_A5, pad 1AC18 */
		WIFI,host_wake_irq = <&gpio2 RK_PA5 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	wireless_bluetooth: wireless-bluetooth {
		compatible = "bluetooth-platdata";
		uart_rts_gpios = <&gpio3 RK_PA6 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default", "rts_gpio";
		pinctrl-0 = <&uart2m0_rtsn_pins>;
		pinctrl-1 = <&uart2_gpios>;
		status = "okay";
	};
};

/* ---------------------------------------------------------------- power --- */

&i2c0 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0m0_pins>;	/* GPIO0_C2/C3, "I2C0_SCL/SDA_PMIC" */

	rk801: pmic@27 {
		compatible = "rockchip,rk801";
		reg = <0x27>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PC0 IRQ_TYPE_LEVEL_LOW>;	/* "PMIC_INT" */
		pwrctrl-gpios = <&gpio0 RK_PC1 GPIO_ACTIVE_HIGH>;	/* "PWR_CTRL" */
		pinctrl-names = "default", "pmic-reset";
		pinctrl-0 = <&pmic_int_pins>;
		pinctrl-1 = <&pmic_pwrctrl_pins>;
		rockchip,system-power-controller;
		wakeup-source;
		status = "okay";

		vcc1-supply = <&vcc5v_dcin>;
		vcc2-supply = <&vcc5v_dcin>;
		vcc3-supply = <&vcc5v0_sys>;
		vcc4-supply = <&vcc5v0_sys>;
		vcc5-supply = <&vcc3v3_sys>;
		vcc6-supply = <&vcc3v3_sys>;
		vcc7-supply = <&vcc3v3_sys>;

		regulators {
			vdd_npu: DCDC_REG1 {
				regulator-name = "vdd_npu";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1500000>;
				regulator-initial-mode = <0x1>;
				regulator-boot-on;
				regulator-always-on;

				regulator-state-mem {
					regulator-mode = <0x2>;
					regulator-off-in-suspend;
				};
			};

			vcc3v3_sys: DCDC_REG2 {
				regulator-name = "vcc3v3_sys";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-initial-mode = <0x1>;
				regulator-boot-on;
				regulator-always-on;

				regulator-state-mem {
					regulator-mode = <0x2>;
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			/*
			 * DDR4 core rail, measured 1.21 V. Deliberately left without
			 * min/max so no driver ever retunes the rail under the running
			 * DRAM; the PMIC brings it up from OTP before the SoC is out
			 * of reset.
			 */
			vcc_ddr: DCDC_REG3 {
				regulator-name = "vcc_ddr";
				regulator-initial-mode = <0x1>;
				regulator-boot-on;
				regulator-always-on;

				regulator-state-mem {
					regulator-mode = <0x2>;
					regulator-on-in-suspend;
				};
			};

			vdd_logic: DCDC_REG4 {
				regulator-name = "vdd_logic";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1500000>;
				regulator-initial-mode = <0x1>;
				regulator-boot-on;
				regulator-always-on;

				regulator-state-mem {
					regulator-mode = <0x2>;
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <900000>;
				};
			};

			/*
			 * LDO1 keeps the stock reference configuration. The power board
			 * schematic is not in this repo yet, so the rail it feeds is
			 * unconfirmed - see the notes file before changing it.
			 */
			vdd0v9_sys: LDO_REG1 {
				regulator-name = "vdd0v9_sys";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcc_1v8: LDO_REG2 {
				regulator-name = "vcc_1v8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			vcc_3v3: SWITCH_REG {
				regulator-name = "vcc_3v3";
				regulator-boot-on;
				regulator-always-on;

				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};
		};
	};
};

&cpu0 {
	cpu-supply = <&vdd_cpu>;
};

&dmc {
	center-supply = <&vdd_logic>;
	status = "okay";
};

&saradc0 {
	status = "okay";
	vref-supply = <&vcc_1v8>;
	/*
	 * SARADC0_IN7 (pad 1A20) is the dedicated BOOT strap read by the BootROM.
	 * It can be exposed as an adc-key once the divider thresholds on the
	 * power board are measured.
	 */
};

/* ----------------------------------------------------------- rtc / imu --- */

&i2c2 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2m0_pins>;	/* GPIO0_D0/D1, "I2C2_SCL/SDA" */

	rtc_rv3028: rtc@52 {
		compatible = "microcrystal,rv3028";
		reg = <0x52>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PC5 IRQ_TYPE_LEVEL_LOW>;	/* "RTC_INT" */
		pinctrl-names = "default";
		pinctrl-0 = <&rtc_int_pins>;
		wakeup-source;
		/*
		 * No backup cell is fitted (U5 has CLKOUT, EVI, VDD and /INT only),
		 * so the trickle charger stays off.
		 */
		status = "okay";
	};
};

&spi1 {
	status = "okay";
	max-freq = <10000000>;
	pinctrl-names = "default";
	/* GPIO6_B4 clk, GPIO6_B3 miso, GPIO6_B2 mosi, GPIO6_B1 csn0 */
	pinctrl-0 = <&spi1m0_clk_pins &spi1m0_csn0_pins>;

	imu@0 {
		/* U6 LSM6DSVQTR. Schematic nets are named SPI0_* but the SoC
		 * function on GPIO6_B1..B4 is SPI1_M0. Do not enable SPI1 CSN1:
		 * that pad is GPIO6_B0 / CAM_PWDN.
		 */
		compatible = "st,lsm6dsv";
		reg = <0>;
		spi-max-frequency = <1000000>;
		spi-cpha;
		spi-cpol;
		interrupt-parent = <&gpio3>;
		interrupts = <RK_PB4 IRQ_TYPE_EDGE_RISING>;	/* "IMU_INT1" */
		st,drdy-int-pin = <1>;
		st,disable-sensor-hub;
		st,odr-triggered;
		pinctrl-names = "default";
		pinctrl-0 = <&imu_int_pins>;
		vdd-supply = <&vcc3v3_sys>;
		vddio-supply = <&vcc_1v8>;
		mount-matrix = "1", "0", "0",
			       "0", "1", "0",
			       "0", "0", "1";
		status = "okay";
	};
};

/* -------------------------------------------------------------- camera --- */

&i2c3 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3m1_pins>;	/* GPIO4_A4/A5, "I2C3_SCL/SDA_CAM" */

	sc233hgs: sc233hgs@30 {
		compatible = "smartsens,sc233hgs";
		reg = <0x30>;
		clocks = <&cru CLK_CAM0_OUT>;
		clock-names = "xvclk";
		assigned-clocks = <&cru CLK_CAM0_OUT>;
		assigned-clock-rates = <27000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk0_pins &cam_pwdn_pins>;
		/* "CAM_PWDN" GPIO4_A6, pad 1T21, J2 pin 17 */
		pwdn-gpios = <&gpio4 RK_PA6 GPIO_ACTIVE_HIGH>;
		avdd-supply = <&vcc2v8_cam>;
		dovdd-supply = <&vcc1v8_cam>;
		dvdd-supply = <&vcc1v5_cam>;
		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "default";
		rockchip,camera-module-lens-name = "default";
		status = "okay";

		port {
			sc233hgs_out: endpoint {
				remote-endpoint = <&csi_dphy_input0>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
};

&csi2_dphy0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			csi_dphy_input0: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&sc233hgs_out>;
				data-lanes = <1 2 3 4>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			csidphy0_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&mipi0_csi2_input>;
			};
		};
	};
};

/*
 * Capture pipeline, one sensor on D-PHY0:
 *   sc233hgs -> csi2_dphy0 -> mipi0_csi2 -> rkcif_mipi_lvds
 *            -> rkisp_vir0 -> rkvpss_vir0
 */
&mipi0_csi2 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi0_csi2_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&csidphy0_out>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi0_csi2_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cif_mipi_in0>;
			};
		};
	};
};

&rkcif {
	status = "okay";
};

&rkcif_mipi_lvds {
	status = "okay";

	port {
		cif_mipi_in0: endpoint {
			remote-endpoint = <&mipi0_csi2_output>;
		};
	};
};

&rkcif_mipi_lvds_sditf {
	status = "okay";

	port {
		mipi_lvds_sditf: endpoint {
			remote-endpoint = <&isp_vir0>;
		};
	};
};

&rkisp {
	status = "okay";
};

&rkisp_vir0 {
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		isp_vir0: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&mipi_lvds_sditf>;
		};
	};
};

&rkisp_vir0_sditf {
	status = "okay";

	port {
		isp_sditf0: endpoint {
			remote-endpoint = <&vpss0_in>;
		};
	};
};

&rkvpss {
	status = "okay";
};

&rkvpss_vir0 {
	status = "okay";

	port {
		vpss0_in: endpoint {
			remote-endpoint = <&isp_sditf0>;
		};
	};
};

&rkdvbm {
	status = "okay";
};

/* MIPI DSI is fanned out to J1 but no panel is fitted. */
&dsi {
	status = "disabled";
};

/* ------------------------------------------------------ storage / wifi --- */

&emmc {
	status = "okay";
	bus-width = <8>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	non-removable;
	no-sd;
	no-sdio;
	rockchip,default-sample-phase = <90>;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_pins>;
	vmmc-supply = <&vcc3v3_sys>;
	vqmmc-supply = <&vcc_1v8>;
};

/* No microSD socket on this board. GPIO0_A5 doubles as SDMMC0_DET and is
 * used for the green LED, so sdmmc0 must stay off.
 */
&sdmmc0 {
	status = "disabled";
};

&sdmmc1 {
	status = "okay";
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	supports-highspeed;
	sd-uhs-sdr104;
	keep-power-in-suspend;
	non-removable;
	disable-wp;
	no-sd;
	no-mmc;
	max-frequency = <150000000>;
	mmc-pwrseq = <&sdio_pwrseq>;
	vmmc-supply = <&vcc3v3_wifi>;
	vqmmc-supply = <&vcc_1v8>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc1_clk_pins &sdmmc1_cmd_pins &sdmmc1_bus4_pins>;
};

/* ---------------------------------------------------------------- uart --- */

&uart0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart0m2_xfer_pins>;
};

/* Bluetooth side of the VS6621S80, 4-wire with hardware flow control. */
&uart2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart2m0_xfer_pins &uart2m0_ctsn_pins &uart2m0_rtsn_pins>;
};

/* ----------------------------------------------------------------- usb --- */

&usb2phy {
	status = "okay";
};

/*
 * The USB-C port is a passive CH221K sink. There is no HUSB311 / Type-C PD
 * controller on any I2C bus. Do not describe usb-role-switch or extcon: those
 * wait on a chip that is not fitted and will leave /sys/class/udc empty, or
 * deadlock dwc3 if the OTG PHY is enabled at the same time.
 *
 * Attach is VBUS from the host. The OTG port of the USB2 PHY must be okay or
 * there is no UDC for the gadget.
 */
&usb2phy_otg {
	status = "okay";
};

&usb3phy {
	status = "okay";
};

/*
 * Device only. dr_mode "peripheral" is what a rebuilt kernel DTB should use.
 * The flashed stock blob cannot grow that string in place, so the shipped
 * boot.img keeps "otg" but with role-switch and extcon names removed.
 */
&usb_drd_dwc3 {
	status = "okay";
	dr_mode = "peripheral";
};

&usb_host_ehci {
	status = "disabled";
};

&usb_host_ohci {
	status = "disabled";
};

/* ------------------------------------------------------------- unused --- */

/* Every FEPHY/ETH pin is reused: GPIO3_B4 as IMU_INT1 and GPIO6_B1..B4 as
 * SPI1, so the MAC must stay off.
 */
&gmac {
	status = "disabled";
};

&spi0 {
	status = "disabled";
};

&i2c1 {
	status = "disabled";
};

&i2c4 {
	status = "disabled";
};

&i2c5 {
	status = "disabled";
};

/* -------------------------------------------------------------- pinmux --- */

&pinctrl {
	pmic {
		pmic_int_pins: pmic-int-pins {
			rockchip,pins = <0 RK_PC0 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		/* RK801 drives this line to reset the SoC. */
		pmic_pwrctrl_pins: pmic-pwrctrl-pins {
			rockchip,pins = <0 RK_PC1 RK_FUNC_GPIO &pcfg_output_high>;
		};
	};

	status-led {
		status_led_pins: status-led-pins {
			rockchip,pins =
				<0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>,
				<0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>,
				<0 RK_PA4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	camera {
		cam_pwdn_pins: cam-pwdn-pins {
			rockchip,pins = <4 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		/* Frame sync / external trigger to J2, unused by default. */
		cam_sync_pins: cam-sync-pins {
			rockchip,pins = <4 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		cam_trigger_pins: cam-trigger-pins {
			rockchip,pins = <4 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	rtc {
		rtc_int_pins: rtc-int-pins {
			rockchip,pins = <0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		/* RTC_EVI timestamp input, GPIO0_C4, pad 1AC8. */
		rtc_evi_pins: rtc-evi-pins {
			rockchip,pins = <0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	imu {
		imu_int_pins: imu-int-pins {
			rockchip,pins =
				<3 RK_PB4 RK_FUNC_GPIO &pcfg_pull_none>,
				<6 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	wifi {
		wifi_reg_on: wifi-reg-on {
			rockchip,pins = <3 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		wifi_pwctl_en: wifi-pwctl-en {
			rockchip,pins = <2 RK_PA4 RK_FUNC_GPIO &pcfg_output_low>;
		};

		wifi_wake_host: wifi-wake-host {
			rockchip,pins = <2 RK_PA5 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	bluetooth {
		uart2_gpios: uart2-gpios {
			rockchip,pins = <3 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};
