/dts-v1/;

/ {
	compatible = "rockchip,rv1126b-evb1-v11", "rockchip,rv1126b";
	interrupt-parent = <&gic>;
	#address-cells = <0x1>;
	#size-cells = <0x1>;
	model = "Luckfox Aura";
	aliases {
		csi2dphy0 = <0x2f637369 0x322d6470 0x68793000>;
		csi2dphy1 = <0x2f637369 0x322d6470 0x68793100>;
		csi2dphy2 = <0x2f637369 0x322d6470 0x68793200>;
		csi2dphy3 = <0x2f637369 0x322d6470 0x68793300>;
		csi2dphy4 = <0x2f637369 0x322d6470 0x68793400>;
		csi2dphy5 = <0x2f637369 0x322d6470 0x68793500>;
		ethernet0 = "/ethernet@21c70000";
		gpio0 = "/pinctrl/gpio@20600000";
		gpio1 = "/pinctrl/gpio@21300000";
		gpio2 = "/pinctrl/gpio@21700000";
		gpio3 = "/pinctrl/gpio@21e00000";
		gpio4 = "/pinctrl/gpio@21800000";
		gpio5 = "/pinctrl/gpio@21900000";
		gpio6 = "/pinctrl/gpio@21a00000";
		gpio7 = "/pinctrl/gpio@21b00000";
		i2c0 = "/i2c@21100000";
		i2c1 = "/i2c@21110000";
		i2c2 = "/i2c@20800000";
		i2c3 = "/i2c@21120000";
		i2c4 = "/i2c@21130000";
		i2c5 = "/i2c@21140000";
		mmc0 = "/mmc@21470000";
		mmc1 = "/mmc@21d60000";
		mmc2 = "/mmc@21f60000";
		rkcif_mipi_lvds0 = "/rkcif-mipi-lvds";
		rkcif_mipi_lvds1 = "/rkcif-mipi-lvds1";
		rkcif_mipi_lvds2 = "/rkcif-mipi-lvds2";
		rkcif_mipi_lvds3 = "/rkcif-mipi-lvds3";
		serial0 = "/serial@20810000";
		serial1 = "/serial@21160000";
		serial2 = "/serial@21170000";
		serial3 = "/serial@21180000";
		serial4 = "/serial@21190000";
		serial5 = "/serial@211a0000";
		serial6 = "/serial@211b0000";
		serial7 = "/serial@211c0000";
		spi0 = "/spi@211e0000";
		spi1 = "/spi@211f0000";
		spi2 = "/spi@21460000";
		spi3 = "/spi@208c0000";
	};
	clocks {
		compatible = "simple-bus";
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		ranges;
		sai0_fs: sai0-fs {
			compatible = "fixed-clock";
			#clock-cells = <0x0>;
			clock-frequency = <0x0>;
			clock-output-names = "fs_inter_from_sai0";
			status = "disabled";
		};
		sai1_fs: sai1-fs {
			compatible = "fixed-clock";
			#clock-cells = <0x0>;
			clock-frequency = <0x0>;
			clock-output-names = "fs_inter_from_sai1";
			status = "disabled";
		};
		sai2_fs: sai2-fs {
			compatible = "fixed-clock";
			#clock-cells = <0x0>;
			clock-frequency = <0x0>;
			clock-output-names = "fs_inter_from_sai2";
			status = "disabled";
		};
		sai0_mclkin: sai0-mclkin {
			compatible = "fixed-clock";
			#clock-cells = <0x0>;
			clock-frequency = <0x0>;
			clock-output-names = "mclk_sai0_from_io";
			status = "disabled";
		};
		sai1_mclkin: sai1-mclkin {
			compatible = "fixed-clock";
			#clock-cells = <0x0>;
			clock-frequency = <0x0>;
			clock-output-names = "mclk_sai1_from_io";
			status = "disabled";
		};
		sai2_mclkin: sai2-mclkin {
			compatible = "fixed-clock";
			#clock-cells = <0x0>;
			clock-frequency = <0x0>;
			clock-output-names = "mclk_sai2_from_io";
			status = "disabled";
		};
		sai0_sclkin: sai0-sclkin {
			compatible = "fixed-clock";
			#clock-cells = <0x0>;
			clock-frequency = <0x0>;
			clock-output-names = "sclk_sai0_from_io";
			status = "disabled";
		};
		sai1_sclkin: sai1-sclkin {
			compatible = "fixed-clock";
			#clock-cells = <0x0>;
			clock-frequency = <0x0>;
			clock-output-names = "sclk_sai1_from_io";
			status = "disabled";
		};
		sai2_sclkin: sai2-sclkin {
			compatible = "fixed-clock";
			#clock-cells = <0x0>;
			clock-frequency = <0x0>;
			clock-output-names = "sclk_sai2_from_io";
			status = "disabled";
		};
		xin32k: xin32k {
			compatible = "fixed-clock";
			#clock-cells = <0x0>;
			clock-frequency = <0x8000>;
			clock-output-names = "xin32k";
		};
		xin24m: xin24m {
			compatible = "fixed-clock";
			#clock-cells = <0x0>;
			clock-frequency = <0x16e3600>;
			clock-output-names = "xin24m";
		};
		clk_rcosc: clk_rcosc {
			compatible = "fixed-clock";
			#clock-cells = <0x0>;
			clock-frequency = <0x5b8d800>;
			clock-output-names = "clk_rcosc";
		};
		sai0_mclkout: sai0-mclkout@20100048 {
			compatible = "rockchip,clk-out";
			reg = <0x20100048 0x4>;
			clocks = <&cru 0x73>;
			#clock-cells = <0x0>;
			clock-output-names = "mclk_sai0_to_io";
			rockchip,bit-shift = <0x0>;
			rockchip,bit-set-to-disable;
			status = "disabled";
		};
		sai1_mclkout: sai1-mclkout@20100048 {
			compatible = "rockchip,clk-out";
			reg = <0x20100048 0x4>;
			clocks = <&cru 0x74>;
			#clock-cells = <0x0>;
			clock-output-names = "mclk_sai1_to_io";
			rockchip,bit-shift = <0x1>;
			rockchip,bit-set-to-disable;
			status = "disabled";
		};
		sai2_mclkout: sai2-mclkout@20100048 {
			compatible = "rockchip,clk-out";
			reg = <0x20100048 0x4>;
			clocks = <&cru 0x75>;
			#clock-cells = <0x0>;
			clock-output-names = "mclk_sai2_to_io";
			rockchip,bit-shift = <0x2>;
			rockchip,bit-set-to-disable;
			status = "disabled";
		};
		pvtpll_core: pvtpll-core@20480000 {
			compatible = "rockchip,rv1126b-core-pvtpll", "syscon";
			reg = <0x20480000 0x100>;
			clocks = <&cru 0x4>;
			#clock-cells = <0x0>;
			clock-output-names = "clk_core_pvtpll";
			assigned-clocks = <&pvtpll_core>;
			assigned-clock-rates = <0x47868c00>;
			nvmem-cells = <&cpu_opp_info 0x5>;
			nvmem-cell-names = "opp-info", "specification_serial_number";
		};
		pvtpll_isp: pvtpll-isp@21c60000 {
			compatible = "rockchip,rv1126b-isp-pvtpll";
			reg = <0x21c60000 0x100>;
			rockchip,cru = <0x2>;
			#clock-cells = <0x0>;
			clock-output-names = "clk_isp_pvtpll";
			assigned-clocks = <&pvtpll_isp>;
			assigned-clock-rates = <0x1d34ce80>;
		};
		pvtpll_enc: pvtpll-enc@21f00000 {
			compatible = "rockchip,rv1126b-enc-pvtpll";
			reg = <0x21f00000 0x100>;
			#clock-cells = <0x0>;
			clock-output-names = "clk_vepu_pvtpll";
			assigned-clocks = <&pvtpll_enc>;
			assigned-clock-rates = <0x20c85580>;
		};
		pvtpll_aisp: pvtpll-aisp@21fc0000 {
			compatible = "rockchip,rv1126b-aisp-pvtpll";
			reg = <0x21fc0000 0x100>;
			rockchip,cru = <0x2>;
			#clock-cells = <0x0>;
			clock-output-names = "clk_vcp_pvtpll";
			assigned-clocks = <&pvtpll_aisp>;
			assigned-clock-rates = <0x2e318fc0>;
		};
		pvtpll_npu: pvtpll-npu@22080000 {
			compatible = "rockchip,rv1126b-npu-pvtpll", "syscon";
			reg = <0x22080000 0x100>;
			rockchip,cru = <0x2>;
			clocks = <&cru 0x7f>;
			#clock-cells = <0x0>;
			clock-output-names = "clk_npu_pvtpll";
			assigned-clocks = <&pvtpll_npu>;
			assigned-clock-rates = <0x2faf0800>;
			nvmem-cells = <&npu_opp_info 0x5>;
			nvmem-cell-names = "opp-info", "specification_serial_number";
		};
	};
	cpus {
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x0>;
			enable-method = "psci";
			clocks = <&cru 0x4>;
			cpu-idle-states = <0xb>;
			cpu-supply = <&vdd_cpu>;
		};
		cpu1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x1>;
			enable-method = "psci";
			clocks = <&cru 0x4>;
			operating-points-v2 = <&cpu_opp_table>;
			cpu-idle-states = <0xb>;
		};
		cpu2: cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x2>;
			enable-method = "psci";
			clocks = <&cru 0x4>;
			operating-points-v2 = <&cpu_opp_table>;
			cpu-idle-states = <0xb>;
		};
		cpu3: cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x3>;
			enable-method = "psci";
			clocks = <&cru 0x4>;
			operating-points-v2 = <&cpu_opp_table>;
			cpu-idle-states = <0xb>;
		};
		idle-states {
			entry-method = "psci";
			CPU_SLEEP: cpu-sleep {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <0x78>;
				exit-latency-us = <0xfa>;
				min-residency-us = <0x384>;
			};
		};
	};
	cpu_opp_table: cpu0-opp-table {
		compatible = "operating-points-v2";
		opp-shared;
		mbist-vmin = <0xcf850 0xdbba0 0xe7ef0>;
		nvmem-cells = <&cpu_leakage 0x4 0xf 0x10 0x5>;
		nvmem-cell-names = "leakage", "opp-info", "mbist-vmin", "pvtm", "specification_serial_number";
		rockchip,supported-hw;
		rockchip,pvtm-voltage-sel = <0x0 0x685 0x0 0x686 0x6b2 0x1 0x6b3 0x6df 0x2 0x6e0 0x70c 0x3 0x70d 0x739 0x4 0x73a 0x766 0x5 0x767 0x793 0x6 0x794 0x7ed 0x7 0x7ee 0x270f 0x8>;
		rockchip,pvtm-pvtpll;
		rockchip,pvtm-offset = <0x54>;
		rockchip,pvtm-sample-time = <0x1f4>;
		rockchip,pvtm-freq = <0x188940>;
		rockchip,pvtm-volt = <0x10c8e0>;
		rockchip,pvtm-ref-temp = <0x28>;
		rockchip,pvtm-temp-prop = <0x0 0x0>;
		rockchip,pvtm-thermal-zone = <0x6370752d 0x74686572 0x6d616c00>;
		rockchip,grf = <0x3>;
		rockchip,temp-hysteresis = <0x1388>;
		rockchip,low-temp = <0x2710>;
		rockchip,low-temp-min-volt = <0xe7ef0>;
		opp-594000000 {
			opp-supported-hw = <0xf9 0xffff>;
			opp-hz = <0x0 0x2367b880>;
			opp-microvolt = <0xcf850 0xcf850 0x10c8e0>;
			opp-microvolt-L0 = <0xdbba0 0xdbba0 0x10c8e0>;
			opp-microvolt-L1 = <0xd59f8 0xd59f8 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
			opp-suspend;
		};
		opp-816000000 {
			opp-supported-hw = <0xf9 0xffff>;
			opp-hz = <0x0 0x30a32c00>;
			opp-microvolt = <0xcf850 0xcf850 0x10c8e0>;
			opp-microvolt-L0 = <0xdbba0 0xdbba0 0x10c8e0>;
			opp-microvolt-L1 = <0xd59f8 0xd59f8 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};
		opp-1008000000 {
			opp-supported-hw = <0xf9 0xffff>;
			opp-hz = <0x0 0x3c14dc00>;
			opp-microvolt = <0xcf850 0xcf850 0x10c8e0>;
			opp-microvolt-L0 = <0xdbba0 0xdbba0 0x10c8e0>;
			opp-microvolt-L1 = <0xd59f8 0xd59f8 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};
		opp-1200000000 {
			opp-supported-hw = <0xf9 0xffff>;
			opp-hz = <0x0 0x47868c00>;
			opp-microvolt = <0xdbba0 0xdbba0 0x10c8e0>;
			opp-microvolt-L0 = <0xe7ef0 0xe7ef0 0x10c8e0>;
			opp-microvolt-L1 = <0xe1d48 0xe1d48 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};
		opp-1296000000 {
			opp-supported-hw = <0xf9 0xffff>;
			opp-hz = <0x0 0x4d3f6400>;
			opp-microvolt = <0xe7ef0 0xe7ef0 0x10c8e0>;
			opp-microvolt-L0 = <0xf4240 0xf4240 0x10c8e0>;
			opp-microvolt-L1 = <0xee098 0xee098 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};
		opp-1416000000 {
			opp-supported-hw = <0xf9 0xffff>;
			opp-hz = <0x0 0x54667200>;
			opp-microvolt = <0xee098 0xee098 0x10c8e0>;
			opp-microvolt-L0 = <0xfa3e8 0xfa3e8 0x10c8e0>;
			opp-microvolt-L1 = <0xf4240 0xf4240 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};
		opp-1512000000 {
			opp-supported-hw = <0xf9 0xffff>;
			opp-hz = <0x0 0x5a1f4a00>;
			opp-microvolt = <0xf4240 0xf4240 0x10c8e0>;
			opp-microvolt-L0 = <0x100590 0x100590 0x10c8e0>;
			opp-microvolt-L1 = <0xfa3e8 0xfa3e8 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};
		opp-1608000000 {
			opp-supported-hw = <0xf9 0xffff>;
			opp-hz = <0x0 0x5fd82200>;
			opp-microvolt = <0xf4240 0xf4240 0x10c8e0>;
			opp-microvolt-L0 = <0x10c8e0 0x10c8e0 0x10c8e0>;
			opp-microvolt-L1 = <0x106738 0x106738 0x10c8e0>;
			opp-microvolt-L2 = <0x100590 0x100590 0x10c8e0>;
			opp-microvolt-L3 = <0xfa3e8 0xfa3e8 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};
		opp-j-594000000 {
			opp-supported-hw = <0x4 0xffff>;
			opp-hz = <0x0 0x2367b880>;
			opp-microvolt = <0xdbba0 0xdbba0 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
			opp-suspend;
		};
		opp-j-816000000 {
			opp-supported-hw = <0x4 0xffff>;
			opp-hz = <0x0 0x30a32c00>;
			opp-microvolt = <0xdbba0 0xdbba0 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};
		opp-j-1008000000 {
			opp-supported-hw = <0x4 0xffff>;
			opp-hz = <0x0 0x3c14dc00>;
			opp-microvolt = <0xdbba0 0xdbba0 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};
		opp-j-1200000000 {
			opp-supported-hw = <0x4 0xffff>;
			opp-hz = <0x0 0x47868c00>;
			opp-microvolt = <0xdbba0 0xdbba0 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};
		opp-j-1296000000 {
			opp-supported-hw = <0x4 0xffff>;
			opp-hz = <0x0 0x4d3f6400>;
			opp-microvolt = <0xdbba0 0xdbba0 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};
		cpu_opp_j_od_1416000000: opp-j-od-1416000000 {
			opp-supported-hw = <0x4 0xffff>;
			opp-hz = <0x0 0x54667200>;
			opp-microvolt = <0xe7ef0 0xe7ef0 0x10c8e0>;
			opp-microvolt-L0 = <0xfa3e8 0xfa3e8 0x10c8e0>;
			opp-microvolt-L1 = <0xf4240 0xf4240 0x10c8e0>;
			opp-microvolt-L2 = <0xee098 0xee098 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
			status = "disabled";
		};
		cpu_opp_j_od_1512000000: opp-j-od-1512000000 {
			opp-supported-hw = <0x4 0xffff>;
			opp-hz = <0x0 0x5a1f4a00>;
			opp-microvolt = <0xee098 0xee098 0x10c8e0>;
			opp-microvolt-L0 = <0x100590 0x100590 0x10c8e0>;
			opp-microvolt-L1 = <0xfa3e8 0xfa3e8 0x10c8e0>;
			opp-microvolt-L2 = <0xf4240 0xf4240 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
			status = "disabled";
		};
		cpu_opp_j_od_1608000000: opp-j-od-1608000000 {
			opp-supported-hw = <0x4 0xffff>;
			opp-hz = <0x0 0x5fd82200>;
			opp-microvolt = <0xf4240 0xf4240 0x10c8e0>;
			opp-microvolt-L0 = <0x10c8e0 0x10c8e0 0x10c8e0>;
			opp-microvolt-L1 = <0x106738 0x106738 0x10c8e0>;
			opp-microvolt-L2 = <0x100590 0x100590 0x10c8e0>;
			opp-microvolt-L3 = <0xfa3e8 0xfa3e8 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
			status = "disabled";
		};
		cpu_opp_j_od_1750000000: opp-j-od-1750000000 {
			opp-supported-hw = <0x4 0xffff>;
			opp-hz = <0x0 0x684ee180>;
			opp-microvolt = <0x10c8e0 0x10c8e0 0x10c8e0>;
			opp-microvolt-L4 = <0x106738 0x106738 0x10c8e0>;
			opp-microvolt-L5 = <0x100590 0x100590 0x10c8e0>;
			opp-microvolt-L6 = <0x100590 0x100590 0x10c8e0>;
			opp-microvolt-L7 = <0x100590 0x100590 0x10c8e0>;
			opp-microvolt-L8 = <0x100590 0x100590 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
			status = "disabled";
		};
	};
	cpuinfo {
		compatible = "rockchip,cpuinfo";
		nvmem-cells = <&otp_id 0x12 0x13 0x5>;
		nvmem-cell-names = "id", "cpu-version", "cpu-code", "spec-sn";
	};
	csi2_dphy0: csi2-dphy0 {
		compatible = "rockchip,rv1126b-csi2-dphy";
		rockchip,hw = <0x14 0x15>;
		status = "okay";
		ports {
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			port@0 {
				reg = <0x0>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				csi_dphy_input0: endpoint@1 {
					reg = <0x1>;
					remote-endpoint = <&imx415_0_out>;
					data-lanes = <0x1 0x2 0x3 0x4>;
				};
				csi_dphy_input1: endpoint@2 {
					reg = <0x2>;
					remote-endpoint = <&mia1321_0_out>;
					data-lanes = <0x1 0x2>;
				};
			};
			port@1 {
				reg = <0x1>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				csidphy0_out: endpoint@0 {
					reg = <0x0>;
					remote-endpoint = <&mipi0_csi2_input>;
				};
			};
		};
	};
	csi2_dphy1: csi2-dphy1 {
		compatible = "rockchip,rv1126b-csi2-dphy";
		rockchip,hw = <0x14 0x15>;
		status = "disabled";
	};
	csi2_dphy2: csi2-dphy2 {
		compatible = "rockchip,rv1126b-csi2-dphy";
		rockchip,hw = <0x14 0x15>;
		status = "disabled";
	};
	csi2_dphy3: csi2-dphy3 {
		compatible = "rockchip,rv1126b-csi2-dphy";
		rockchip,hw = <0x14 0x15>;
		status = "disabled";
	};
	csi2_dphy4: csi2-dphy4 {
		compatible = "rockchip,rv1126b-csi2-dphy";
		rockchip,hw = <0x14 0x15>;
		status = "disabled";
	};
	csi2_dphy5: csi2-dphy5 {
		compatible = "rockchip,rv1126b-csi2-dphy";
		rockchip,hw = <0x14 0x15>;
		status = "disabled";
	};
	display_subsystem: display-subsystem {
		compatible = "rockchip,display-subsystem";
		ports = <0x19>;
		status = "okay";
		logo-memory-region = <0x1a>;
		route {
			route_dsi: route-dsi {
				status = "okay";
				logo,uboot = "logo.bmp";
