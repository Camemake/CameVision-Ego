			typec5v_pwren: typec5v-pwren {
				rockchip,pins = <0x0 0x16 0x0 0x100>;
			};
			vcc5v0_host_en: vcc5v0-host-en {
				rockchip,pins = <0x0 0x14 0x0 0x100>;
			};
		};
		cam {
			cam_reset_gpio: cam-reset-gpio {
				rockchip,pins = <0x4 0x8 0x0 0x102>;
			};
		};
		sdio-pwrseq {
			wifi_enable_h: wifi-enable-h {
				rockchip,pins = <0x3 0xe 0x0 0x102>;
			};
			pcm_out: pcm-out {
				rockchip,pins = <0x3 0xb 0x0 0x102>;
			};
