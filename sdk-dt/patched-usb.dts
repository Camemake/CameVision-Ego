	pmu: power-management@20838000 {
		compatible = "rockchip,rv1126b-pmu", "syscon", "simple-mfd";
		reg = <0x20838000 0x400>;
		power: power-controller {
			compatible = "rockchip,rv1126b-power-controller";
			#power-domain-cells = <0x1>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			status = "okay";
			power-domain@0 {
				reg = <0x0>;
				pm_qos = <0x50>;
				pm_shaping = <0x51>;
				clocks = <&cru 0x7e>;
			};
			power-domain@1 {
				reg = <0x1>;
				pm_qos = <0x52 0x53 0x54 0x55>;
				pm_shaping = <0x56 0x57 0x58 0x59>;
				clocks = <&cru 0x43>;
				rockchip,always-on;
			};
			power-domain@2 {
				reg = <0x2>;
				pm_qos = <0x5a>;
			};
		};
	};
