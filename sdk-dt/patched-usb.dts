		compatible = "rockchip,rv1126b-i2c";
		reg = <0x21100000 0x1000>;
		interrupts = <0x0 0x30 0x4>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		clocks = <&cru 0x11e 0x2 0x11d>;
		clock-names = "i2c", "pclk";
		pinctrl-names = "default";
		pinctrl-0 = <&i2c0m0_pins>;
		status = "okay";
		rk801: rk801@27 {
			compatible = "rockchip,rk801";
			status = "okay";
			reg = <0x27>;
			interrupt-parent = <&gpio0>;
			interrupts = <0x10 0x8>;
			pwrctrl-gpios = <&gpio0 0x11 0x0>;
			pinctrl-names = "default", "pmic-reset";
			pinctrl-0 = <&pmic_int>;
			pinctrl-1 = <&soc_pwrctrl_reset>;
			rockchip,system-power-controller;
			wakeup-source;
			vcc1-supply = <&vcc5v_dcin>;
			vcc2-supply = <&vcc5v_dcin>;
			vcc3-supply = <&vcc5v0_sys>;
			vcc4-supply = <&vcc5v0_sys>;
			vcc5-supply = <&vcc3v3_sys>;
			vcc6-supply = <&vcc3v3_sys>;
			vcc7-supply = <&vcc3v3_sys>;
			regulators {
				vdd_npu: DCDC_REG1 {
					regulator-name = "vdd_npu";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x16e360>;
					regulator-initial-mode = <0x1>;
					regulator-boot-on;
					regulator-always-on;
					regulator-state-mem {
						regulator-mode = <0x2>;
						regulator-off-in-suspend;
						regulator-suspend-microvolt = <0xe7ef0>;
					};
				};
				vcc3v3_sys: DCDC_REG2 {
					regulator-name = "vcc3v3_sys";
					regulator-min-microvolt = <0x325aa0>;
					regulator-max-microvolt = <0x325aa0>;
					regulator-initial-mode = <0x1>;
					regulator-boot-on;
					regulator-always-on;
					regulator-state-mem {
						regulator-mode = <0x2>;
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0x325aa0>;
					};
				};
				vcc_ddr: DCDC_REG3 {
					regulator-name = "vcc_ddr";
					regulator-boot-on;
					regulator-always-on;
					regulator-state-mem {
						regulator-mode = <0x2>;
						regulator-on-in-suspend;
					};
				};
				vdd_logic: DCDC_REG4 {
					regulator-name = "vdd_logic";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x16e360>;
					regulator-initial-mode = <0x1>;
					regulator-boot-on;
					regulator-always-on;
					regulator-state-mem {
						regulator-mode = <0x2>;
						regulator-off-in-suspend;
						regulator-suspend-microvolt = <0xdbba0>;
					};
				};
				vdd0v9_sys: LDO_REG1 {
					regulator-name = "vdd0v9_sys";
					regulator-min-microvolt = <0x325aa0>;
					regulator-max-microvolt = <0x325aa0>;
					regulator-boot-on;
					regulator-always-on;
					regulator-state-mem {
						regulator-off-in-suspend;
						regulator-suspend-microvolt = <0x325aa0>;
					};
				};
				vcc_1v8: LDO_REG2 {
					regulator-name = "vcc_1v8";
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x325aa0>;
					regulator-boot-on;
					regulator-always-on;
					regulator-state-mem {
						regulator-off-in-suspend;
						regulator-suspend-microvolt = <0x1b7740>;
					};
				};
				vcc_3v3: SWITCH_REG {
					regulator-name = "vcc_3v3";
					regulator-boot-on;
					regulator-always-on;
					regulator-state-mem {
						regulator-off-in-suspend;
						regulator-suspend-microvolt = <0x325aa0>;
					};
				};
			};
		};
	};
